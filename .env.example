# 1. CẤU HÌNH MÁY CHỦ & MÔI TRƯỜNG ANTIGRAVITY
PORT=3456
ANTIGRAVITY_ENV=production
NODE_ENV=production
BASE_URL=http://localhost:3456
JWT_SECRET=datphu_kinke_jwt_secret_2026_change_in_production_min32chars!

# 2. KHÓA AI & MÔ HÌNH NGÔN NGỮ (GEMINI / ANTIGRAVITY SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# 3. KẾT NỐI CƠ SỞ DỮ LIỆU SUPABASE POSTGRESQL (RLS ENABLED)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
POSTGRES_CONNECTION_STRING=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 4. TÀI KHOẢN TỔNG ĐÀI ĐIỀU PHỐI & VIETQR VIETCOMBANK (CHÍNH CHỦ ĐẤT PHÚ)
VCB_BANK_ID=VCB
VCB_ACCOUNT_NO=0751000025858
VCB_ACCOUNT_NAME="CONG TY TNHH THUONG MAI DAT PHU"
VCB_WEBHOOK_SECRET=datphu_vcb_ipn_hmac_sha256_secret_key

# 5. TỰ ĐỘNG HÓA N8N & THÔNG BÁO KHẨN CẤP (TELEGRAM / ZALO OA)
