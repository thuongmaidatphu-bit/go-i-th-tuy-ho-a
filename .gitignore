# ==============================================================================
# .GITIGNORE — BẢO VỆ DỮ LIỆU & BÍ MẬT HỆ THỐNG ĐẤT PHÚ KÍN KẼ OS™
# Tuân thủ: Nghị định 13/2023/NĐ-CP & Tiêu chuẩn Zero-Leakage
# ==============================================================================

# 1. BIẾN MÔI TRƯỜNG & KHÓA BẢO MẬT (TUYỆT ĐỐI KHÔNG ĐƯỢC COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.pfx
*.cert
service-account*.json
credentials.json

# 2. THƯ VIỆN & PHỤ THUỘC (ASSET-LIGHT)
node_modules/
package-lock.json

# 3. NHẬT KÝ & TEMPORARY FILES
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# 4. TỆP TIN HỆ ĐIỀU HÀNH & TRÌNH SOẠN THẢO
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# 5. DỮ LIỆU SAO LƯU DỰ PHÒNG & ARCHIVES
*.zip
*.tar.gz
*.rar
*.7z
backup/
backups/
temp/
tmp/
